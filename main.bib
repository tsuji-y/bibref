  publisher = "Cambridge University Press (CUP)",
  volume    =  75,
  number    =  2,
  pages     = "381--396",
  abstract  = "Individual members of the U. S. Congress work with staffs ranging
               in size from a minimum of 18 to a maximum of well over 100. Each
