@ARTICLE{Widner2020-kp,
  title    = "Lobbying inside (and) out: Interest group behavior on social media",
  author   = "Widner, Kirsten and MacDonald, Mary and Gunderson, Anna",
  journal  = "APSA Preprints",
  abstract = "This project asks whether existing patterns of lobbying are
