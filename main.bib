@ARTICLE{Lee2010-ra,
  title     = "Senate deliberation and the future of congressional power",
  author    = "Lee, Frances E",
  journal   = "PS Polit. Sci. Polit.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  43,
  number    =  2,
  pages     = "227--229",
  abstract  = "Current circumstances might seem to present real opportunities
               for Congress to reassert itself relative to its weakened role
               during George W. Bush's presidency. Large, unusually cohesive
               Democratic majorities in both chambers; unified government; and
               an administration staffed with people who know Congress well—all
