@ARTICLE{Krehbiel1990-mg,
  title     = "Are congressional committees composed of preference outliers?",
  author    = "Krehbiel, Keith",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  84,
  number    =  1,
  pages     = "149--163",
  abstract  = "A diverse set of congressional studies portrays members of
               standing committees as more or less homogeneous “high demanders”
               or “preference outliers” relative to members of the larger
               legislature. Using interest group ratings of members of the
               Ninety-sixth to Ninety-ninth Congresses, I conduct conventional
