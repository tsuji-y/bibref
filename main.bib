  month     =  mar,
  year      =  1989,
  language  = "en"
}

@ARTICLE{Simon1985-mx,
  title     = "Human nature in politics: The dialogue of psychology with
               political science",
  author    = "Simon, Herbert A",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  79,
  number    =  2,
  pages     = "293--304",
  abstract  = "This article compares two theories of human rationality that have
               found application in political science: procedural, bounded
               rationality from contemporary cognitive psychology, and global,
               substantive rationality from economics. Using examples drawn from
               the recent literature of political science, it examines the
