  journal   = "Am. J. Pol. Sci.",
  publisher = "JSTOR",
  volume    =  38,
  number    =  1,
  pages     =  45,
  abstract  = "[Recently the spatial theory of elections has been challenged by
               critics who dispute the realism of its assumptions and the
               empirical veracity of its predictions. This paper critically
               evaluates two theoretical alternatives to the spatial model and
               subjects these to a series of strategic tests using data from six
