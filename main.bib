@ARTICLE{Niou1985-lx,
  title     = "Universalism in Congress",
  author    = "Niou, Emerson M S and Ordeshook, Peter C",
  journal   = "Am. J. Pol. Sci.",
  publisher = "JSTOR",
  volume    =  29,
  number    =  2,
  pages     =  246,
  abstract  = "Several earlier attempts at explaining the norm of universalism
               in Congress rely on a simple expected value comparison between
               the rewards to legislators of the coalition of the whole as
               against the uncertainties associated with minimal winning
               coalitions. Such a comparison, however, fails to model directly
