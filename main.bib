  language  = "en"
}

@ARTICLE{Skowronek2006-hh,
  title     = "The reassociation of ideas and purposes: Racism, liberalism, and
               the American political tradition",
  author    = "Skowronek, Stephen",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  100,
  number    =  3,
  pages     = "385--401",
  abstract  = "Racist and liberal ideals are said to anchor competing political
               traditions in America, but a juxtaposition of ideals obscures key
               processes of change in the cultural lexicon and misses much about
               how a political tradition comes to bear on the development of a
               polity. Attention to the reassociation of ideas and purposes over
               time points to a more intimate relationship between racism and
               liberalism in American political culture, to the conceptual
               interpenetration of these antithetical ends. Cuing off issues
