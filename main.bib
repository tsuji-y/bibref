@ARTICLE{Grossmann2013-ev,
  title     = "The Variable Politics of the Policy Process: Issue-Area
               Differences and Comparative Networks",
  author    = "Grossmann, Matt",
  journal   = "J. Polit.",
  publisher = "The University of Chicago Press",
  volume    =  75,
  number    =  1,
  pages     = "65--79",
  abstract  = "The politics of policy-issue areas differ in multiple ways,
