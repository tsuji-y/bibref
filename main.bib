@BOOK{Mazo2020-om,
  title     = "The best candidate: Presidential nomination in polarized times",
  author    = "Mazo, Eugene D and Dimino, Michael R",
  editor    = "Mazo, Eugene D and Dimino, Michael R",
  publisher = "Cambridge University Press",
  address   = "Cambridge, England",
  abstract  = "Presidential selection : historical, institutional, and
               democratic perspectives / James A. Gardner -- The historical
               development of the U.S. presidential nomination process / Richard
               H. Pildes -- Constitutional Law and the presidential nomination
               process / Richard Briffault -- Winnowing and endorsing :
