@ARTICLE{Jenkins2014-vr,
  title     = "Negative agenda control and the conservative coalition in the
               {U}.{S}. house",
  author    = "Jenkins, J A and Monroe, N W",
  journal   = "J. Polit.",
  publisher = "Cambridge University Press",
  volume    =  76,
  number    =  4,
  pages     = "1116--1127",
  abstract  = "While it is widely believed that a “conservative coalition” of
               Southern Democrats and Republicans sometimes formed on floor
               votes in the mid-twentieth-century House to block liberal policy
               initiatives, a fully fleshed-out picture of what the coalition
               was and how it operated is lacking. In this article, we
