@INPROCEEDINGS{Miwa2025-nm,
  title     = "Ideal Point Estimation of Political Pundits through Authorship
               Patterns in Opinion Magazines",
  author    = "Miwa, Hirofumi and Omori, Shoko",
  publisher = "Japanese Political Science Association",
  address   = "Tokyo",
  abstract  = "Political pundits, such as commentators, journalists, and
               scholars, often exert influence on the political process by
               publishing their opinions in the media and speaking in assemblies
               or advisory councils. Despite their relevance, they have rarely
               been the subject of systematic analysis in political science,
               partly because it is challenging to measure their political
               preferences objectively—a prerequisite for applying spatial
               models. Assuming that editors of opinion magazines tend to
               commission articles from pundits whose ideological positions are
               close to their own, we propose a statistical model to estimate
               the ideal points of political pundits using data on their
               publication records across opinion magazines. Drawing on data
               from the Japanese Periodicals Index compiled by the National Diet
               Library, we jointly estimate the ideological positions of over
               1,000 authors, including pundits and politicians, and a few dozen
               opinion magazines. We validate our estimates by comparing them
               with ideal points derived from elite surveys, Twitter data, and
               ratings of article titles by a large language model. Finally, to
               demonstrate the utility of the estimated data, we analyze whether
               pundits ideologically close to the government are more likely to
               be appointed as members of advisory committees.",
  year      =  2025
}

