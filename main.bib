  author    = "Meffert, Michael F and Norpoth, Helmut and Ruhil, Anirudh V S",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  95,
  number    =  4,
  pages     = "953--962",
  abstract  = "Aggregate party identification (macropartisanship) has exhibited
               substantial movement in the U.S. electorate over the last half
