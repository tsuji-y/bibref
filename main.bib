  year      =  1995,
  language  = "en"
}

@ARTICLE{Kessler1996-qe,
  title     = "Dynamics of cosponsorship",
  author    = "Kessler, Daniel and Krehbiel, Keith",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  90,
  number    =  3,
  pages     = "555--566",
  abstract  = "Electoral-connection theories of legislative politics view bill
