  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  92,
  number    =  4,
  pages     = "775--790",
  abstract  = "In a departure from previous research, we focus on the dyadic
               relationship between lobbyists and committee members in the House
               of Representatives in order to test hypotheses about what factors
               shape the decisions of individual groups to lobby individual
               committee members. Our primary assumption is that organized
