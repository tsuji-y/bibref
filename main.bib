  month     =  mar,
  year      =  2002,
  language  = "en"
}

@ARTICLE{Canes-Wrone2002-bu,
  title     = "Out of step, out of office: Electoral accountability and House
               members' voting",
  author    = "Canes-Wrone, Brandice and Brady, David W and Cogan, John F",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  96,
  number    =  1,
  pages     = "127--140",
  abstract  = "Does a typical House member need to worry about the electoral
               ramifications of his roll-call decisions? We investigate the
               relationship between incumbents' electoral performance and
               roll-call support for their party—controlling for district
               ideology, challenger quality, and campaign spending, among other
               factors—through a series of tests of the 1956–1996 elections. The
               tests produce three key findings indicating that members are
               indeed accountable for their legislative voting. First, in each
