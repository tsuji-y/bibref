@BOOK{Wallner2019-tw,
  title     = "On parliamentary war: Partisan conflict and procedural change in
               the {U}.s. senate",
  author    = "Wallner, James Ian",
  publisher = "University of Michigan Press",
  address   = "Ann Arbor, MI",
  abstract  = "Dysfunction in the Senate is driven by the deteriorating
               relationship between the majority and minority parties. Regular
               order is virtually nonexistent and unorthodox parliamentary
               procedures are frequently needed to pass important legislation.
               Democrats and Republicans are fighting a parliamentary war in the
               Senate to steer the future of the country. James Wallner presents
