@BOOK{Squire2012-tq,
  title     = "The evolution of American legislatures: Colonies, territories,
               and states, 1619-2009",
  author    = "Squire, Peverill",
  publisher = "University of Michigan Press",
  address   = "Ann Arbor, MI",
  abstract  = "The institutional development of American legislatures, beginning
