  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  95,
  number    =  3,
  pages     = "673--687",
  abstract  = "We analyze party discipline in the House of Representatives
               between 1947 and 1998. The effects of party pressures can be
