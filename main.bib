}

@ARTICLE{Hall1990-zk,
  title     = "The committee assignment process and the conditional nature of
               committee bias",
  author    = "Hall, Richard L and Grofman, Bernard",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  84,
  number    =  4,
  pages     = "1149--1166",
  abstract  = "The view that congressional committees tend to be biased subsets
               of their parent chambers provides the foundations for a
               substantial body of theoretical literature on distributive
               politics and legislative structure. More recent revisionist work
               suggests that committees composed of preference outliers are in
               fact rare. We reject the categorical account of preference
               outliers a priori and elaborate conditions under which committees
               should be unrepresentative of their parent chambers. We argue
               that the most widely available and frequently used data—floor
               roll call votes—are inappropriate to the task of assessing
               outlier predictions in any form. Finally, we conduct a
               differentiated set of hypothesis tests within one policy
               jurisdiction to illustrate the characteristics of evidence and
               analysis necessary to evaluate alternative theoretical accounts
               of legislative organization. The appearance of policy-relevant
               biases in congressional work groups, we conclude, is not so much
               rare as it is conditional, and we suggest several conditions on
               which future models of legislative organization should build.",
  month     =  dec,
  year      =  1990,
  language  = "en"
}

@ARTICLE{Wright1990-qo,
  title     = "Contributions, lobbying, and committee voting in the {U}.s. house
