@ARTICLE{Hardin1976-yw,
  title     = "Hollow victory: The minimum winning coalition",
  author    = "Hardin, Russell",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  70,
  number    =  4,
  pages     = "1202--1214",
  abstract  = "The proof of Riker's size principle is inadequate for the general
               class of zero-sum bargaining games (whether symmetric or
               asymmetric), and the principle is valid only for a very
