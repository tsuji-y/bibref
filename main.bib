@ARTICLE{Steele2017-xm,
  title     = "Constraining the samurai: Rebellion and taxation in early modern
               japan",
  author    = "Steele, Abbey and Paik, Christopher and Tanaka, Seiki",
  journal   = "Int. Stud. Q.",
