@ARTICLE{Hall1990-cr,
  title     = "Buying time: Moneyed interests and the mobilization of bias in
               congressional committees",
  author    = "Hall, Richard L and Wayman, Frank W",
  journal   = "Am. Polit. Sci. Rev.",
