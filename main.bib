  month     =  sep,
  year      =  2002,
  language  = "en"
}

@ARTICLE{Beck2002-js,
  title     = "The social calculus of voting: Interpersonal, media, and
               organizational influences on presidential choices",
  author    = "Beck, Paul Allen and Dalton, Russell J and Greene, Steven and
               Huckfeldt, Robert",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  96,
  number    =  1,
  pages     = "57--73",
  abstract  = "Voting choices are a product of both personal attitudes and
               social contexts, of a personal and a social calculus. Research
               has illuminated the personal calculus of voting, but the social
               calculus has received little attention since the 1940s. This
               study expands our understanding of the social influences on
               individual choice by examining the relationship of partisan
               biases in media, organizational, and interpersonal intermediaries
               to the voting choices of Americans. Its results show that the
               traditional sources of social influence still dominate:
               Interpersonal discussion outweighs the media in affecting the
