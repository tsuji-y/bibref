}

@ARTICLE{Boix2013-qq,
  title     = "The foundations of limited authoritarian government:
               Institutions, commitment, and power-sharing in dictatorships",
  author    = "Boix, Carles and Svolik, Milan W",
  journal   = "J. Polit.",
  publisher = "University of Chicago Press",
  volume    =  75,
  number    =  2,
  pages     = "300--316",
  abstract  = "Why do some dictatorships establish institutions that may
               constrain their leaders? We argue that institutions promote the
               survival of dictatorships by facilitating authoritarian
               power-sharing. Specifically, institutions such as parties,
               legislatures, and advisory councils alleviate commitment and
               monitoring problems between the dictator and his allies caused by
