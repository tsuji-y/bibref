@ARTICLE{Goya-Tocchetto2022-zc,
  title     = "The partisan trade-off bias: When political polarization meets
               policy trade-offs",
  author    = "Goya-Tocchetto, Daniela and Kay, Aaron C and Vuletich, Heidi and
