@ARTICLE{Tauber1999-cl,
  title    = "The {NAACP} Legal Defense Fund and the {U}.{S}. supreme court's
              racial discrimination decision making",
  author   = "Tauber, S",
  journal  = "Social Science Quarterly",
  volume   =  80,
  number   =  2,
  pages    = "325--340",
  abstract = "Most research on interest-group litigation has focused on how a
              particular group's legal strategy influenced the outcome of a
              landmark case, and, generally, this prior research has concluded
              that interest groups affect judicial decision making. The present
              study tests further this notion of group efficacy by investigating
              the impact of the NAACP (National Association for the Advancement
              of Colored People) Legal Defense Fund (LDF) on the totality of
              racial discrimination cases decided in the U.S. Supreme Court and
              by accounting for both the legal and extralegal context
              surrounding judicial decision making. A judicial decision-making
              model analyzing the outcome of the 164 racial discrimination cases
              decided in the U.S. Supreme Court from 1938 to 1993 is examined
              with logistic regression. This model tests whether the LDF exerted
              an independent influence on the outcome of the cases. The LDF did
              not exert a statistically significant impact on the outcome of
              cases as a whole, but it was significant when accounting for the
              moderating influence of court ideology and the U.S. Justice
              Department's participation. For a more balanced assessment, future
              interest-group litigation research should couple the
              landmark-case, legal-strategy approach with an examination of a
              group's impact over the entirety of a legal issue and should
              account directly for extralegal influences.",
  year     =  1999
}

