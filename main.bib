@ARTICLE{Pizza2026-xt,
  title    = "Comparing campaign rhetoric and legislative behavior through
              issue-specific polarization in the {US} house of Representatives,
              {2021–2025}",
  author   = "Pizza, Jillian and Kanopka, Klint",
  journal  = "SocArXiv",
  abstract = "Voters make decisions on who to elect based, in part, upon
              candidate messaging and party platforms. Here we examine the
              relationship between campaign rhetoric and legislative behavior
              among members of the 117th and 118th United States House of
              Representatives. Using campaign text and roll-call voting data,
              the paper compares polarization across policy domains through an
              IssueIRT model of legislative behavior and a Wordscores model of
              campaign rhetoric. We find that polarization varies substantially
              across issue areas and that the relationship between rhetoric and
              behavior is not uniform. Civil Rights exhibits highly polarized
              and morally distinct partisan rhetoric, while Government
              Operations rhetoric displays a more continuous ideological
              spectrum despite strongly polarized voting behavior. International
              Affairs appears comparatively less polarized in both rhetoric and
              legislative behavior, with greater thematic overlap between
              parties surrounding national security and international
              engagement. We also observe a second latent dimension in
              congressional voting associated with institutionalism and
              intra-party factionalism. Republican legislators exhibit
              substantially greater dispersion along this dimension, while
              Democrats remain comparatively cohesive in both rhetoric and
              voting behavior.",
  month    =  jun,
  year     =  2026
}

@ARTICLE{Case2025-jt,
  title    = "Bipartisan campaign messages are credible policymaking signals",
  author   = "Case, Colin and Ommundsen, Emily Cottle and Porter, Rachel",
  journal  = "SocArXiv",
  abstract = "Bipartisan cooperation is essential to congressional productivity
              and democratic legitimacy, yet bipartisan campaign rhetoric is
              widely dismissed as an electioneering tactic that offers voters
              unreliable information about future governance. This skepticism
              calls into question the informational role of campaigns and, in
              turn, the quality of democratic representation. We challenge this
              view, arguing that bipartisan campaign appeals function as
              issue-specific signals that credibly forecast cross-party
              collaboration. Drawing on issue-level statements from U.S. House
              candidates (N=43,465; 2018--2022), we document that bipartisan
              messaging is common across candidates, but deployed selectively
              within campaigns. Linking these commitments to all legislation
              introduced in the 116th--118th Congresses, we show that candidates
              who emphasize bipartisan cooperation on particular issues
              subsequently engage in meaningful cross-party policymaking in
              those domains, which translates to legislative success. We
              demonstrate that candidates’ issue-specific bipartisan commitments
              structure the selective cross-party cooperation that persists in a
              polarized era.",
  month    =  dec,
  year     =  2025,
  language = "en"
}

