@ARTICLE{Berkhout2020-ye,
  title     = "Interest groups in multi-level contexts: European integration as
               cross-cutting issue in party-interest group contacts",
  author    = "Berkhout, Joost and Hanegraaff, Marcel and Statsch, Patrick",
  journal   = "Polit. Gov.",
