@ARTICLE{Nalepa2016-an,
  title     = "Party institutionalization and legislative organization: The
               evolution of agenda power in the polish parliament",
  author    = "Nalepa, Monika",
  journal   = "Comp. Polit.",
  publisher = "Comparative Politics CUNY",
  volume    =  48,
  number    =  3,
  pages     = "353--372",
  abstract  = "Can one organize a legislature for majoritarian control in a
               fragile party system where formal rules grant extensive powers to
               the government opposition and individual parliamentarians?
               Semi-structured interviews with MPs in the Polish Sejm uncover
               that changes in the party system influenced the government's use
