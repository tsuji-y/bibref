@INPROCEEDINGS{Katsumata2022-ew,
  title     = "Statistical Analysis with Machine Learning Predicted Outcomes",
  author    = "Katsumata, Hiroto and Yamauchi, Soichiro",
  publisher = "Japanese Political Science Association",
  abstract  = "The use of large-scale text or image data, combined with machine
               learning techniques, plays an essential role in innovative social
               science research. Researchers have increasingly utilized these
               data to test their theory by investigating the relationship
               between some char- acteristics (e.g., topics or sentiments) of
               such data and some explanatory variables. They routinely take a
               two-step approach that consists of supervised learning and
               subsequent anal- ysis. In the first stage, they hand-label a
               subset of the observations, train machine learning algorithms,
               and predict the label for the rest of the data. The predicted
               outcome is then used in the subsequent statistical analysis to
               answer substantive questions via regression and hypothesis
               testing. This approach, however, can induce substantial bias and
               incorrect inference in the main analysis due to overfitting and
               prediction error in the machine learning stage unless it
               satisfies strong assumptions such as correctly specified machine
               learning mod- els. We propose a method that does not require such
               stringent assumptions. The proposed method enjoys desirable
               statistical properties as if we analyze hand-labeled data, while
               im- proving the accuracy by incorporating information from
               machine learning predictions. We also develop diagnostic tools
               that inform researchers how to improve the main analysis. We
               apply the proposed method to revisit a study that investigates
               the sources of election fraud with ballot image data and
               regression analysis.",
  month     =  aug,
  year      =  2022
}

