  author    = "Iversen, Torben and Soskice, David",
  journal   = "Am. Polit. Sci. Rev.",
  publisher = "Cambridge University Press (CUP)",
  volume    =  100,
  number    =  2,
  pages     = "165--181",
  abstract  = "Standard political economy models of redistribution, notably that
               of Meltzer and Richard (1981), fail to account for the remarkable
