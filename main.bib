@ARTICLE{Schlozman2010-ez,
  title     = "Weapon of the strong? Participatory inequality and the Internet",
  author    = "Schlozman, Kay Lehman and Verba, Sidney and Brady, Henry E",
  journal   = "Perspect. Politics",
  publisher = "Cambridge University Press (CUP)",
  volume    =  8,
  number    =  2,
  pages     = "487--509",
  abstract  = "What is the impact of the possibility of political participation
               on the Internet on long-standing patterns of participatory
